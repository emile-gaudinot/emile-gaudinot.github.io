---
import { siteConfig } from "../config";

const skillStyles: Record<string, string> = {
  activity:
    "bg-purple-500/15 text-purple-800 hover:bg-purple-500/25 dark:bg-purple-400/15 dark:text-purple-200 dark:hover:bg-purple-400/25",
  cloud:
    "bg-indigo-500/15 text-indigo-800 hover:bg-indigo-500/25 dark:bg-indigo-400/15 dark:text-indigo-200 dark:hover:bg-indigo-400/25",
  ml: "bg-sky-500/15 text-sky-800 hover:bg-sky-500/25 dark:bg-sky-400/15 dark:text-sky-200 dark:hover:bg-sky-400/25",
};
---

<section id="about" class="p-8 sm:p-12 md:p-16 lg:p-24">
  <div>
    <div class="grid grid-cols-1 lg:grid-cols-[10.5rem_minmax(0,1fr)] xl:grid-cols-[17.5rem_minmax(0,1fr)] gap-8 lg:gap-x-8 xl:gap-x-6 items-start">
      <div>
        <h2
          class="text-[1.2rem] sm:text-[1.5rem] md:text-[1.8rem] xl:text-[3rem] font-bold text-gray-900 dark:text-white"
        >
          About Me
        </h2>
        <div
          class="w-[75px] h-[5px] mt-2 rounded-full"
          style="background-color: var(--accent-color)"
        >
        </div>
      </div>

      <div class="space-y-8">
        <p class="text-[1.0625rem] sm:text-[1.1875rem] md:text-[1.375rem] leading-relaxed text-justify hyphens-auto text-gray-600 dark:text-gray-300">
          {siteConfig.aboutMe}
        </p>

        <div class="pt-4">
          <div class="flex flex-wrap gap-3">
            {
              siteConfig.skills.map((skill) => (
                <span
                  class={`px-3 sm:px-4 py-1.5 sm:py-2 rounded-full text-sm sm:text-base md:text-lg font-medium transition-colors duration-200 ${skillStyles[skill.category]}`}
                >
                  {skill.name}
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
